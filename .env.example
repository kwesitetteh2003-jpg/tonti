# Server secret used to derive the test Lightning node key and to sign the ledger.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TONTI_SECRET=

# Optional: persist a copy of the ledger as a JSON file (local development).
TONTI_DATA_DIR=./data

# Production: private Vercel Blob token, set automatically when a Blob store is
# connected to the Vercel project. Can also be set by hand as TONTI_BLOB_TOKEN.
# The live ledger is a single snapshot at tonti/ledger.json, read uncached.
# BLOB_READ_WRITE_TOKEN=
